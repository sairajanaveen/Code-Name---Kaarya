# Optional legacy automation URL. The review-first website does not auto-post to Make.
MAKE_WEBHOOK_URL=
# Optional server-to-server intake authentication; do not prefix this with NEXT_PUBLIC_.
INTAKE_WEBHOOK_SECRET=

SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=meeting-assets

SARVAM_API_KEY=your-sarvam-api-key

GEMINI_API_KEY=your-google-ai-studio-key
STRUCTURED_LLM_PROVIDER=gemini
STRUCTURED_LLM_MODEL=gemini-2.5-flash

# Optional: make OpenAI the primary processor instead of Gemini.
# STRUCTURED_LLM_API_KEY=your-openai-key
# STRUCTURED_LLM_PROVIDER=openai
# STRUCTURED_LLM_MODEL=gpt-4.1-mini
# Optional single fallback after a Gemini failure, not an extra call on every draft.
OPENAI_API_KEY=
VALIDATOR_LLM_MODEL=gpt-4.1-mini

NOTION_TOKEN=secret_your_notion_integration_token
NOTION_MEETINGS_DATABASE_ID=your-meetings-database-id
NOTION_TASKS_DATABASE_ID=your-tasks-database-id

# Direct Kaarya email delivery. Use a verified sender/domain before production outreach.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Kaarya <hello@kaarya.tech>
NEXT_PUBLIC_APP_URL=https://kaarya.tech

# Legacy webhook setting. The reviewed-email endpoint uses Resend directly.
EMAIL_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=https://your-teams-incoming-webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook
